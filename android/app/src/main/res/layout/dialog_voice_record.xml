<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/dialog_rounded_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎙️ บันทึกเสียงด่วน"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/mic_pulse_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/widget_circle_bg">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="ไมโครโฟน"
            android:src="@drawable/ic_widget_mic" />
    </FrameLayout>

    <!-- Animated Sound Wave Visualizer Container -->
    <LinearLayout
        android:id="@+id/sound_wave_container"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/wave_bar_1"
            android:layout_width="5dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_2"
            android:layout_width="5dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_3"
            android:layout_width="5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_4"
            android:layout_width="5dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_5"
            android:layout_width="5dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_6"
            android:layout_width="5dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_7"
            android:layout_width="5dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/wave_bar_bg" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🎙️ กำลังฟังเสียง... พูดได้เลยค่ะ"
        android:textColor="#F8C63E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_recognized_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#1E293B"
        android:gravity="center"
        android:minHeight="48dp"
        android:padding="10dp"
        android:text="เช่น 'กินข้าว 60 บาท', 'เติมน้ำมัน 500'"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_cancel_voice"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#334155"
        android:text="ยกเลิก"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
