<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/dialog_rounded_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="พูดเพื่อจดบันทึก"
        android:textColor="#F8FAFC"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="บันทึกอัตโนมัติเมื่อหยุดพูด"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/mic_pulse_container"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/widget_circle_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="ไมโครโฟน"
            android:src="@drawable/ic_widget_mic_modern" />
    </FrameLayout>

    <!-- Minimalist Sound Wave Visualizer Container -->
    <LinearLayout
        android:id="@+id/sound_wave_container"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/wave_bar_1"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_2"
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_3"
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_4"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_5"
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_6"
            android:layout_width="4dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />

        <View
            android:id="@+id/wave_bar_7"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/wave_bar_bg" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="กำลังฟังเสียงพูดของคุณ..."
        android:textColor="#10B981"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_recognized_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_voice_app_icon_bg"
        android:gravity="center"
        android:minHeight="44dp"
        android:padding="12dp"
        android:text="เช่น 'กินข้าว 60 บาท', 'เติมน้ำมัน 500'"
        android:textColor="#E2E8F0"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_cancel_voice"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E293B"
        android:text="ยกเลิก"
        android:textColor="#94A3B8"
        android:textSize="13.5sp" />
</LinearLayout>
